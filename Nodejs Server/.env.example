NODE_ENV=development
PORT=3200
APP_ORIGIN=http://localhost:3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=qr_app
DB_PASSWORD=
DB_NAME=qrcode_project
# 64 hexadecimal characters from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Required for registration; never prints OTP codes as a fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set 465 and SMTP_SECURE=true for implicit TLS. Other ports require STARTTLS.
SMTP_SECURE=false
# 0 for a direct connection; 1 only behind exactly one trusted, isolated reverse proxy.
TRUST_PROXY_HOPS=0
